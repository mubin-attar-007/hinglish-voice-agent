# Copy to .env (git-ignored), or set these as user environment variables.
# Never commit real values. CI needs none of them.

# LLM behind the text-mode agent: mock | gemini
LLM_PROVIDER=mock

# A dedicated Google AI Studio key for this project only
GEMINI_API_KEY=

# Sarvam AI key for speech-to-text and text-to-speech (milestone M2)
SARVAM_API_KEY=
